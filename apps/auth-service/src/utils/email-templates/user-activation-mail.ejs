<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your HashCart Account</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      font-family: Arial, Helvetica, sans-serif;
      color: #1f2937;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f4f6f8; padding: 40px 15px"
    >
      <tr>
        <td align="center">
          <!-- Main Container -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 560px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="padding: 30px 30px 25px; background-color: #111827"
              >
                <div
                  style="
                    font-size: 28px;
                    font-weight: 700;
                    color: #ffffff;
                    letter-spacing: -0.5px;
                  "
                >
                  Hash<span style="color: #60a5fa">Cart</span>
                </div>

                <div style="margin-top: 8px; font-size: 13px; color: #d1d5db">
                  Your trusted online marketplace
                </div>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 40px 40px 35px">
                <h1
                  style="
                    margin: 0 0 15px;
                    font-size: 24px;
                    line-height: 32px;
                    color: #111827;
                    font-weight: 700;
                  "
                >
                  Verify your email address
                </h1>

                <p
                  style="
                    margin: 0 0 20px;
                    font-size: 15px;
                    line-height: 24px;
                    color: #4b5563;
                  "
                >
                  Hi <strong><%= name %></strong>,
                </p>

                <p
                  style="
                    margin: 0 0 25px;
                    font-size: 15px;
                    line-height: 24px;
                    color: #4b5563;
                  "
                >
                  Thanks for creating your HashCart account. Please use the
                  verification code below to confirm your email address.
                </p>

                <!-- OTP Box -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin: 10px 0 25px"
                >
                  <tr>
                    <td align="center">
                      <div
                        style="
                          display: inline-block;
                          background-color: #eff6ff;
                          border: 1px solid #bfdbfe;
                          border-radius: 10px;
                          padding: 18px 35px;
                        "
                      >
                        <div
                          style="
                            font-size: 12px;
                            font-weight: 600;
                            color: #6b7280;
                            text-transform: uppercase;
                            letter-spacing: 1.5px;
                            margin-bottom: 8px;
                          "
                        >
                          Verification Code
                        </div>

                        <div
                          style="
                            font-size: 32px;
                            font-weight: 700;
                            letter-spacing: 8px;
                            color: #2563eb;
                          "
                        >
                          <%= otp %>
                        </div>
                      </div>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 0 0 20px;
                    font-size: 14px;
                    line-height: 22px;
                    color: #6b7280;
                    text-align: center;
                  "
                >
                  This verification code will expire in
                  <strong>5 minutes</strong>.
                </p>

                <p
                  style="
                    margin: 25px 0 0;
                    padding-top: 20px;
                    border-top: 1px solid #e5e7eb;
                    font-size: 13px;
                    line-height: 21px;
                    color: #9ca3af;
                  "
                >
                  If you didn't create a HashCart account, you can safely ignore
                  this email. No action is required.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  padding: 22px 30px;
                  background-color: #f9fafb;
                  border-top: 1px solid #e5e7eb;
                "
              >
                <p
                  style="
                    margin: 0 0 6px;
                    font-size: 13px;
                    font-weight: 600;
                    color: #374151;
                  "
                >
                  HashCart
                </p>

                <p style="margin: 0; font-size: 12px; color: #9ca3af">
                  © <%= new Date().getFullYear() %> HashCart. All rights
                  reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
