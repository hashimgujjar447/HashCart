// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model images {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  file_id String
  url     String
  shopId  String? @unique @db.ObjectId

  userId    String?   @unique @db.ObjectId
  users     users?    @relation(fields: [userId], references: [id])
  shops     shops?    @relation(fields: [shopId], references: [id])
  productId String?   @db.ObjectId
  products  products? @relation(fields: [productId], references: [id])
}

model users {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String        @unique
  avatar    images?
  following String[]
  password  String?
  reviews   shopReviews[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model shopReviews {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      users    @relation(fields: [userId], references: [id])
  rating    Float
  reviews   String?
  shopId    String   @db.ObjectId
  shops     shops    @relation(fields: [shopId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model shops {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  bio           String?
  category      String
  avatar        images?
  coverBanner   String?
  address       String
  website       String?
  opening_hours String?
  socialLinks   Json[]
  ratings       Float         @default(0)
  reviews       shopReviews[]
  sellerId      String        @unique @db.ObjectId
  sellers       sellers       @relation(fields: [sellerId], references: [id])
  products      products[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model sellers {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  phone_number String
  country      String
  password     String
  stripeId     String?
  shop         shops?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model site_config {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  categories    String[]
  subCategories Json
}


model discount_codes{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  public_name String
  discountType String
  discountValue Float
  discountCode String @unique
  sellerId String @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum productStatus {
  Active
  Pending
  Draft
  OutOfStock
  Discontinued
}

model products {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  description         String
  detailedDescription String
  tags                String[]
  warranty            String
  slug                String   @unique
  brand               String?
  cashOnDelivery      String   @default("yes")
  category            String
  subCategory         String
  video_url           String?
  regular_price       Float?
  sale_price          Float
  stock               Int
  sizes               String[]
  discountCodes       String[] @db.ObjectId
  colors              String[]
  specifications      Json?
  customProperties    Json?
  images              images[]
  sellerId            String   @db.ObjectId
  shopId              String?  @db.ObjectId
  status              productStatus @default(Active)
  ratings            Float    @default(5)
  starting_date       DateTime?
  ending_date         DateTime?
  isDeleted           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  shop                shops?   @relation(fields: [shopId], references: [id])
}